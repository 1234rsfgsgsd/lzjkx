# Local testing only. Keep real credentials out of Git and the browser.
# Existing text and image services are still required by the current practice flow.
# Optional real cloud accounts: a persistent PostgreSQL URL from your provider.
# Keep the provider's TLS settings (e.g. sslmode=verify-full). Never commit the real URL.
# If absent, the original browser-only mode stays active. Back up local records before enabling.
DATABASE_URL=
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
SPEECH_MODEL=
XFYUN_ISE_ENABLED=false
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# Optional direct-audio AI feedback. Disabled by default; separate user consent is required.
AUDIO_REVIEW_ENABLED=false
AUDIO_REVIEW_API_URL=
AUDIO_REVIEW_API_KEY=
AUDIO_REVIEW_MODEL=qwen3.8-omni-flash
